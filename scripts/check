#!/usr/bin/env bash
set -euo pipefail

required_tools=(bash cargo git jq python3 rg ruff shellcheck)
missing_tools=()

for tool in "${required_tools[@]}"; do
    if ! command -v "${tool}" >/dev/null 2>&1; then
        missing_tools+=("${tool}")
    fi
done

if ((${#missing_tools[@]} > 0)); then
  printf 'error: missing required check tools: %s\n' "${missing_tools[*]}" >&2
  exit 1
fi

cargo_deny_bin="$(command -v cargo-deny 2>/dev/null || true)"
if [[ -z "${cargo_deny_bin}" ]]; then
    cargo_home_dir="${CARGO_HOME:-$HOME/.cargo}"
    if [[ -x "${cargo_home_dir}/bin/cargo-deny" ]]; then
        cargo_deny_bin="${cargo_home_dir}/bin/cargo-deny"
    else
        printf 'error: missing required check tool: cargo-deny\n' >&2
        exit 1
    fi
fi

cargo fmt --all -- --check
cargo clippy --locked --all-targets --all-features -- -D warnings
cargo test --locked --all-targets --all-features
cargo package --locked --allow-dirty
"${cargo_deny_bin}" check

shopt -s nullglob
shell_files=(scripts/check scripts/*-acceptance.sh spikes/*.sh)
python_files=(spikes/*.py)
fixture_files=(spikes/fixtures/*.json)

for shell_file in "${shell_files[@]}"; do
    bash -n "${shell_file}"
done
shellcheck "${shell_files[@]}"

if ((${#python_files[@]} > 0)); then
    ruff check "${python_files[@]}"
    ruff format --check "${python_files[@]}"
fi

for fixture_file in "${fixture_files[@]}"; do
    jq empty "${fixture_file}"
done

scripts/d12-presentation-harness-acceptance.sh
bash scripts/d17-source-acceptance.sh

git diff --check
git diff --cached --check
